---
import SectionHeader from "./SectionHeader.astro";

interface Position {
  title: string;
  period?: string;
}

interface Role {
  company: string;
  positions: Position[];
  period: string;
  location: string;
  bullets: string[];
}

const roles: Role[] = [
  {
    company: "B1 Marketing Group",
    positions: [
      { title: "Lead Software Engineer", period: "Jun 2026 – Oct 2026" },
      { title: "Software Engineer", period: "Jul 2025 – Jun 2026" },
    ],
    period: "Jul 2025 – Oct 2026",
    location: "Gilbert, AZ",
    bullets: [
      "Led architecture and development of a Python/Django microservices platform for legal-claimant qualification, including its SaaS launch with tenant isolation, MFA, usage reporting, and initial client onboarding.",
      "Built server-rendered HTMX intake forms and a responsive, real-time operations workspace; cut sessions-page load times from 1.5–1.9 s to 0.1–0.6 s by eliminating redundant queries and caching repeated lookups.",
      "Designed and developed a document-generation system that assembled campaign-specific reports, signed retainers, and supporting evidence into client packages using report-generation and orchestration Lambdas.",
      "Owned API integrations for fraud screening, enrichment, identity verification, e-signature, and CRM; implemented callback reconciliation, idempotency, and configuration-as-code for templates and workflows.",
      "Co-led a five-person team before becoming sole technical lead; translated business goals into phased specs, mentored engineers, and standardized LLM-assisted workflows with human review and automated checks.",
      "Managed AWS with Terraform and least-privilege IAM; cut CI critical-path runtime by approximately 70% via E2E restructuring and parallelization; introduced one-click deployments, blue-green releases, and rollbacks.",
    ],
  },
  {
    company: "Balance Health",
    positions: [{ title: "Co-Founder & CTO" }],
    period: "May 2025 – Present",
    location: "Remote",
    bullets: [
      "Rebuilt and launched a patient-billing platform as sole engineer, replacing a visual-builder prototype with a React/TanStack Start application; serves 41 practices, 32 onboarded in 2026.",
      "Automated patient-to-statement matching and email/SMS payment requests with delivery tracking; the platform reached a monthly record of $215K in patient collections.",
      "Built Stripe-powered patient checkout with practice branding and subdomains, partial payments, recovery after interrupted payments, and idempotent webhook processing.",
      "Migrated production from Cloudflare Workers to Google Cloud to support HIPAA compliance requirements and gain finer control over service scaling.",
    ],
  },
  {
    company: "Devize",
    positions: [{ title: "Product Builder" }],
    period: "Oct 2024 – Jul 2025",
    location: "Gilbert, AZ",
    bullets: [
      "Delivered seven full-stack client applications spanning healthcare billing, lead qualification, CRM, and operational tools; worked directly with clients to define scope and prioritize subsequent releases.",
      "Extended the visual-builder platform with reusable frontend components and backend integration plugins used across the team's client applications.",
    ],
  },
];

interface Education {
  school: string;
  degree: string;
  year: string;
}

const education: Education[] = [
  {
    school: "Western Governors University",
    degree: "BS, Computer Science",
    year: "2024",
  },
  {
    school: "University of Arizona",
    degree: "BSBA, Finance",
    year: "2019",
  },
];

const certifications = ["ITIL Foundation", "Linux Essentials", "HIPAA Associate"];
---

<section id="experience" class="section-padding relative" aria-labelledby="experience-heading">
  <div class="mx-auto max-w-6xl px-6">
    <SectionHeader id="experience" label="experience" />

    <div class="relative">
      <div
        class="absolute top-2 bottom-2 left-[7px] hidden w-px lg:block"
        style="background: repeating-linear-gradient(
          to bottom,
          var(--color-screen-raised) 0px,
          var(--color-screen-raised) 4px,
          transparent 4px,
          transparent 8px
        );"
      >
      </div>

      <div class="space-y-12">
        {
          roles.map((role, i) => (
            <div class="stagger-child relative lg:pl-10" style={`--stagger: ${i}`}>
              {/* Timeline node — amber LED */}
              <div class="absolute top-1.5 left-0 hidden h-[15px] w-[15px] lg:block">
                <div class="bg-screen-dark border-glow-primary/50 h-full w-full rounded-full border-2" />
                <div class="bg-glow-primary/30 absolute inset-1 rounded-full" />
              </div>

              {/* Role content */}
              <div>
                <div class="mb-1 flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-3">
                  <h3 class="text-text-bright text-lg font-semibold">{role.company}</h3>
                  {role.positions.length === 1 && (
                    <span class="text-text-faint font-mono text-xs">{role.period}</span>
                  )}
                </div>

                {role.positions.map((position) => (
                  <p class="mb-1 flex flex-wrap items-baseline gap-x-3 font-mono text-sm">
                    <span class="text-glow-primary/80">{position.title}</span>
                    {position.period && (
                      <span class="text-text-faint text-xs whitespace-nowrap">
                        {position.period}
                      </span>
                    )}
                  </p>
                ))}
                <p class="text-text-faint mt-1 mb-4 text-sm">{role.location}</p>

                <ul class="space-y-2">
                  {role.bullets.map((bullet) => (
                    <li class="text-text-muted before:text-text-faint relative pl-4 text-sm leading-relaxed before:absolute before:left-0 before:text-xs before:content-['▸']">
                      {bullet}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <section id="education" class="mt-20 scroll-mt-20" aria-labelledby="education-heading">
      <SectionHeader id="education" label="education" class="mb-8" />

      <div class="grid gap-6 sm:grid-cols-2">
        {
          education.map((edu, i) => (
            <div
              class="stagger-child bg-screen-panel/30 border-screen-raised/50 rounded-lg border p-5"
              style={`--stagger: ${i + 3}`}
            >
              <h3 class="text-text-bright mb-1 font-medium">{edu.school}</h3>
              <p class="text-text-muted font-mono text-sm">{edu.degree}</p>
              <p class="text-text-faint mt-1 font-mono text-xs">{edu.year}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-6 flex flex-wrap gap-2">
        {certifications.map((cert) => <span class="pixel-tag rounded">{cert}</span>)}
      </div>
    </section>
  </div>
</section>

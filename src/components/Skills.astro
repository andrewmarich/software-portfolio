---
import SectionHeader from "./SectionHeader.astro";

interface SkillGroup {
  label: string;
  skills: string[];
}

const groups: SkillGroup[] = [
  {
    label: "Languages",
    skills: ["TypeScript", "JavaScript", "Python", "SQL"],
  },
  {
    label: "Technologies",
    skills: [
      "React",
      "TanStack Start",
      "Django",
      "HTMX",
      "Node.js",
      "PostgreSQL",
      "Redis",
      "Drizzle ORM",
      "Astro",
    ],
  },
  {
    label: "Cloud & DevOps",
    skills: [
      "AWS (ECS, Lambda, RDS, S3, SQS)",
      "GCP (Cloud Run, Cloud Tasks)",
      "Terraform",
      "Docker",
      "CI/CD",
    ],
  },
  {
    label: "Testing",
    skills: ["Playwright", "Selenium", "Vitest", "pytest", "React Testing Library", "k6"],
  },
  {
    label: "AI Tooling",
    skills: [
      "Claude Code",
      "Codex",
      "OpenCode",
      "MCP",
      "custom skills",
      "agent hooks",
      "self-hosted LLMs",
    ],
  },
];
---

<section
  id="skills"
  class="section-padding-tight relative overflow-hidden"
  aria-labelledby="skills-heading"
>
  <div class="glow-pool glow-pool--cyan glow-pool--left-center"></div>

  <div class="mx-auto max-w-6xl px-6">
    <SectionHeader id="skills" label="ls skills/" />

    <div class="grid gap-8 sm:grid-cols-2">
      {
        groups.map((group, i) => (
          <div class="stagger-child" style={`--stagger: ${i}`}>
            <h3 class="text-text-faint mb-4 font-mono text-sm tracking-wider uppercase">
              [{group.label}]
            </h3>
            <div class="flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <span class="pixel-tag rounded">{skill}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

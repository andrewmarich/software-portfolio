---
import { Image } from "astro:assets";
import leadsDashboard from "../assets/images/leads-dashboard.webp";
import balanceDashboard from "../assets/images/balance-dashboard.png";
import portfolioScreenshot from "../assets/images/portfolio-screenshot.png";
import SectionHeader from "./SectionHeader.astro";

interface Project {
  name: string;
  subtitle: string;
  description: string;
  tags: string[];
  image: ImageMetadata;
  accent: string;
  accentRgb: string;
}

const projects: Project[] = [
  {
    name: "Claimant Qualification Platform",
    subtitle: "B1 Marketing Group",
    description:
      "Qualifies prospective legal claimants and delivers client-ready packages to law firms. Agents work in dynamic forms, the system validates and enriches data through third-party APIs, then assembles reports, signed retainers, and evidence into a single package. Grew into a multi-tenant SaaS with MFA and usage reporting.",
    tags: ["Python", "Django", "HTMX", "PostgreSQL", "AWS", "Terraform", "Redis", "DocuSign"],
    image: leadsDashboard,
    accent: "oklch(64% .204 222)",
    accentRgb: "14,165,233",
  },
  {
    name: "Patient Billing Platform",
    subtitle: "Balance Health",
    description:
      "Patient billing for healthcare practices. Matches patients to statements, sends email and SMS payment requests, and handles checkout with partial payments, Apple Pay, and Stripe Link. Rebuilt from an unlaunched prototype as sole engineer; now serves 41 practices.",
    tags: ["React", "TanStack Start", "PostgreSQL", "Google Cloud", "Stripe"],
    image: balanceDashboard,
    accent: "#3aa769",
    accentRgb: "58,167,105",
  },
  {
    name: "Software Portfolio",
    subtitle: "marich.dev",
    description:
      "The site you're on right now. Mostly static with React islands where interactivity matters. Has a few things hidden around if you like poking at websites.",
    tags: ["Astro", "React", "TypeScript", "Tailwind CSS 4", "Cloudflare"],
    image: portfolioScreenshot,
    accent: "#ff2d6f",
    accentRgb: "255,45,111",
  },
];
---

<section
  id="projects"
  class="section-padding relative overflow-hidden"
  aria-labelledby="projects-heading"
>
  <div class="glow-pool glow-pool--primary glow-pool--right-center"></div>

  <div class="mx-auto max-w-6xl px-6">
    <SectionHeader id="projects" label="ls projects/" />

    <div class="space-y-6">
      {
        projects.map((project, i) => (
          <article
            class="stagger-child bg-screen-panel/50 border-screen-raised/20 relative rounded-lg border p-6 transition-all duration-300 lg:p-8"
            style={`--accent: ${project.accent}; --accent-rgb: ${project.accentRgb}; --stagger: ${i}`}
            data-hover-glow
          >
            <div class="flex flex-col gap-6 lg:flex-row">
              <div class="crt-hover bg-screen-dark border-screen-raised/50 relative w-full shrink-0 overflow-hidden rounded-md border lg:w-80">
                <Image
                  src={project.image}
                  alt={`${project.name} screenshot`}
                  widths={[320, 640, 960]}
                  sizes="(min-width: 1024px) 320px, 100vw"
                  class="block h-auto w-full"
                  loading="lazy"
                />
              </div>

              <div class="min-w-0 flex-1">
                <div class="mb-1 flex items-center gap-3">
                  <div class="h-2 w-2 rounded-full" style={`background: ${project.accent};`} />
                  <h3 class="text-xl font-semibold" style={`color: ${project.accent};`}>
                    {project.name}
                  </h3>
                </div>

                <p class="text-text-faint mb-3 pl-5 font-mono text-xs tracking-wider uppercase">
                  {project.subtitle}
                </p>

                <p class="text-text-muted mb-4 leading-relaxed">{project.description}</p>

                <div class="flex flex-wrap gap-2">
                  {project.tags.map((tag) => (
                    <span class="pixel-tag rounded">{tag}</span>
                  ))}
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
